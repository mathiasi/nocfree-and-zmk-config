#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/*
 * macOS layout, Nordic ISO, factory keycaps (Fn outermost). The Windows
 * layout is config/windows.keymap. The two differ on purpose in three
 * places: the bottom row, the crossed ISO keys described below, and the
 * F-row (shortcuts unmodified here, F1-F12 behind Fn). Never copy one file
 * over the other; a change that belongs on both is made in both, by hand.
 */

/*
 * ISO map, the factory arrangement throughout, plus a Caps-Lock navigation
 * layer. For macOS with a Nordic layout.
 *
 * This is a user-config keymap: it replaces the board keymap at
 * boards/nocfree/nocfree_and/nocfree_and.keymap wholesale, so the behaviour
 * nodes that file declares are redeclared here.
 *
 * Positional, not national. HID usage codes say which key moved; the host
 * layout decides the character. This is the standard positional map plus the
 * two codes ANSI has no room for, so it serves Nordic, German, French,
 * Spanish and every other ISO layout equally. Set the layout in the OS.
 *
 *   NON_US_BSLH  the key between LSHFT and Z      Nordic: < > backslash
 *   NON_US_HASH  the key left of the ISO Enter    Nordic: apostrophe, star
 *
 * Except that on macOS those first two are crossed, and this keymap crosses
 * them back. macOS maps HID 0x35 (GRAVE) and 0x64 (NON_US_BSLH) the opposite
 * way round from Windows, Linux and every other host, on any ISO keyboard
 * that is not an Apple one. Bound positionally, the result is that the key
 * left of Z types what the key left of 1 should, and vice versa.
 *
 * MEASURED on this unit, macOS 27, Danish layout, keyboard type set to ISO:
 *
 *   key left of 1, sending GRAVE          typed  <  >     wanted  $  §
 *   key left of Z, sending NON_US_BSLH    typed  $  §     wanted  <  >
 *
 * So the two are swapped here: the key left of 1 sends NON_US_BSLH and the
 * key left of Z sends GRAVE. Each key then produces its own legend. This is
 * the one place the firmware compensates for a host rather than describing
 * the hardware, and it is why this file is not portable back to Windows --
 * doing that needs these two put back as well as the bottom row.
 *
 * Bindings are listed in visual reading order. Each line pair is one physical
 * row: the left half first, then the right half. Row widths are
 * 7+8, 7+8, 6+8, 6+8, 7+8, 5+7 = 85.
 *
 * Layers: 0 base, 1 Fn, 2 Nav (held with Caps Lock).
 *
 * The top row is inverted relative to the arrangement NocFree publishes, at
 * the owner's request, to match how Apple's own keyboards behave: the
 * Mac-legend shortcuts -- brightness, Mission Control, Spotlight, media -- are
 * what the keys do unmodified, and F1-F12 are behind Fn.
 *
 * The legends printed on these caps are the shortcuts, so the base layer now
 * does what the caps say and the F-numbers are the hidden meaning. NocFree
 * ships it the other way round.
 *
 * This needs a matching host setting, and does nothing useful without it.
 * With "Use F1, F2, etc. keys as standard function keys" OFF -- the macOS
 * default -- macOS reinterprets F1-F12 as media keys itself, so Fn+F1 would
 * arrive as brightness-down and a real F1 would be unreachable. Turn it ON:
 * System Settings -> Keyboard -> Keyboard Shortcuts -> Function Keys. The
 * base layer is unaffected by that setting either way, because it sends
 * consumer usages rather than F-numbers.
 *
 * Esc stays Esc, Home/End stay put, and Fn+Esc is still the bootloader.
 * The bottom row is the factory order; see below.
 *
 * Two bindings sit in slots the factory arrangement leaves empty, because
 * this firmware drives hardware the factory map does not address:
 *
 *   Fn+F5 / Fn+F6   backlight off / on. Absolute BL_SET levels only. ZMK
 *                   relays the backlight behaviour to the peripheral but
 *                   never syncs the resulting state, and each half keeps its
 *                   own brightness in its own NVS, so one BL_INC lost to a
 *                   split-link hiccup would leave a permanent offset that
 *                   survives reboots. BL_SET lands both halves on one number.
 *   Fn+i            types the battery level as "bat NN". That number is a
 *                   stub and reads 100 permanently; see docs/battery.md.
 *
 * The top row's last three keys read Home, End, Delete, matching the legends
 * on this unit. Upstream's manufacturer-documented table put Print Screen and
 * Home there, but that table was derived from the ANSI board and does not
 * describe this one -- the owner read the keys off the physical keyboard.
 * Print Screen keeps a home on Fn+Home.
 *
 * The bottom row is the factory order, matching the Mac legends on the retail
 * keycaps:
 *
 *   left    Fn / Control / Option / Command, outside in
 *   right   Command / Fn / Option, reading outward from the space bar
 *
 * Command lands under either thumb, which is where macOS wants it -- every
 * system shortcut is a Command chord. Option needs no special placement,
 * because a Nordic layout on macOS takes its third-level characters --
 * @ $ { [ ] } and the backslash and pipe -- from Option, and an Option key
 * sits one out from each thumb already.
 *
 * The Windows sibling of this config rearranges this row: LGUI and LALT
 * into PC order, and AltGr in beside the space bar, because under Windows
 * those same characters come from AltGr and the factory row puts it three
 * keys out, behind Command and Fn. Neither departure buys anything on macOS,
 * so this keymap leaves the row as the factory drew it. To rebuild the
 * Windows row: swap LALT with LGUI on the left, RGUI with RALT on the right.
 * That unit also runs Control outermost, because its Control and Fn keycaps
 * were physically swapped and the firmware follows the caps; this one has
 * factory caps, so Fn stays on the edge.
 *
 * Recovery keys. Both halves can be dropped into their preserved UF2
 * bootloader from the keymap, and both the factory combinations and the
 * port's own are bound, so either muscle memory works:
 *
 *   Fn+5  or  Fn+Esc      left half     (factory firmware uses Fn+5)
 *   Fn+0  or  Fn+Delete   right half    (factory firmware uses Fn+0)
 *
 * This works because ZMK reset behaviours act on the half whose key triggered
 * them, and 5 and Esc are both left-half keys while 0 and Delete are both
 * right-half ones -- the same split the factory combinations rely on. Tap
 * resets that half; hold 1.5 s reaches the bootloader. Binding Fn+5 and Fn+0
 * displaced two Bluetooth controls, which moved one key outward:
 * profile 4 is now Fn+6, and clear-profile is now Fn+Backspace.
 */

/ {
    behaviors {
        /*
         * Types the battery percentage out as "bat NN". A macro cannot do
         * this: macros send a sequence fixed at compile time and the
         * percentage is a runtime value. Output is digits, letters and space
         * only, which sit in the same places on every ISO layout.
         */
        batt_report: battery_report {
            compatible = "nocfree,behavior-battery-report";
            #binding-cells = <0>;
            display-name = "Battery";
        };

        /*
         * A hold-tap always passes two parameters to its bound behaviours.
         * &bootloader and &sys_reset take none, so every use passes two
         * zeroes.
         *
         * tap-preferred: a quick tap is a reset even if the key is still held
         * when the next one arrives. Only a deliberate 1.5 s hold reaches the
         * bootloader.
         */
        boot_reset: bootloader_or_reset {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&bootloader>, <&sys_reset>;
            tapping-term-ms = <1500>;
            flavor = "tap-preferred";
        };

        /*
         * Caps Lock, held, is the navigation layer; tapped, it is still Caps
         * Lock.
         *
         * hold-preferred rather than ZMK's stock &lt, which is tap-preferred:
         * tap-preferred resolves only on the timer, so every arrow would cost
         * a 200 ms wait before it registered. hold-preferred resolves as soon
         * as another key goes down, so Caps+J is an immediate Left. The
         * trade-off is that pressing another key while Caps is still held
         * always means the layer -- which is what you want here, because Caps
         * Lock is a key you tap on its own and essentially never chord.
         */
        caps_nav: caps_lock_or_nav {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;
            tapping-term-ms = <200>;
            flavor = "hold-preferred";
            display-name = "Caps/Nav";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
                &kp ESC   &kp C_BRI_DN &kp C_BRI_UP &kp C_AC_DESKTOP_SHOW_ALL_WINDOWS &kp C_AC_SEARCH &bl BL_SET 0 &bl BL_SET 100
                &kp C_PREVIOUS &kp C_PLAY_PAUSE &kp C_NEXT &kp C_MUTE &kp C_VOL_DN &kp C_VOL_UP &kp HOME &kp END

                &kp NON_US_BSLH &kp N1 &kp N2 &kp N3 &kp N4   &kp N5    &kp N6
                &kp N7    &kp N8    &kp N9    &kp N0    &kp MINUS &kp EQUAL &kp BSPC  &kp PG_UP

                &kp TAB   &kp Q     &kp W     &kp E     &kp R     &kp T
                &kp Y     &kp U     &kp I     &kp O     &kp P     &kp LBKT  &kp RBKT  &kp PG_DN

                &caps_nav 2 CAPS    &kp A     &kp S     &kp D     &kp F     &kp G
                &kp H     &kp J     &kp K     &kp L     &kp SEMI  &kp SQT   &kp NON_US_HASH &kp RET

                &kp LSHFT &kp GRAVE &kp Z     &kp X     &kp C     &kp V     &kp B
                &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH  &kp RSHFT &kp UP    &kp DEL

                &mo 1     &kp LCTRL &kp LALT  &kp LGUI  &kp SPACE
                &kp SPACE &kp RGUI  &mo 1     &kp RALT  &kp LEFT  &kp DOWN  &kp RIGHT
            >;
        };

        /*
         * Function layer. The function row follows the contract NocFree
         * publishes for the Mac legends on the retail keycaps.
         *
         *   Fn+Esc        tap: reset the left half   hold 1.5 s: its bootloader
         *   Fn+5          the same, matching factory firmware's combination
         *   Fn+F1 / F2    display brightness down / up
         *   Fn+F3         Mission Control         Fn+F4  Spotlight
         *   Fn+F5 / F6    backlight off / on      (this firmware, not factory)
         *   Fn+F7..F12    prev, play/pause, next, mute, volume down, volume up
         *   Fn+Home       Print Screen
         *   Fn+1..Fn+4    select Bluetooth profile 0..3
         *   Fn+6          select Bluetooth profile 4
         *   Fn+Backspace  clear the selected Bluetooth profile
         *   Fn+U          send HID over USB       Fn+B  send HID over Bluetooth
         *   Fn+i          type the battery level as "bat NN"
         *   Fn+Delete     tap: reset the right half  hold 1.5 s: its bootloader
         *   Fn+0          the same, matching factory firmware's combination
         *
         * Fn+Delete and Fn+0 need the split link up to reach the right half,
         * and that half needs its own USB cable for its bootloader drive to
         * appear. Either half can always be recovered over its USB CDC
         * interface instead; see docs/recovery.md.
         */
        function_layer {
            display-name = "Fn";
            bindings = <
                &boot_reset 0 0 &kp F1 &kp F2 &kp F3  &kp F4    &kp F5    &kp F6
                &kp F7    &kp F8    &kp F9    &kp F10   &kp F11   &kp F12   &kp PSCRN &trans

                &trans     &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &boot_reset 0 0 &bt BT_SEL 4
                &trans     &trans     &trans  &boot_reset 0 0 &trans     &trans     &bt BT_CLR &trans

                &trans     &trans     &trans     &trans     &trans     &trans
                &trans     &out OUT_USB &batt_report &trans   &trans     &trans     &trans     &trans

                &trans     &trans     &trans     &trans     &trans     &trans
                &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans

                &trans     &trans     &trans     &trans     &trans     &trans     &out OUT_BLE
                &trans     &trans     &trans     &trans     &trans     &trans     &trans  &boot_reset 0 0

                &trans     &trans     &trans     &trans     &trans
                &trans     &trans     &trans     &trans     &trans     &trans     &trans
            >;
        };

        /*
         * Navigation layer, held with Caps Lock.
         *
         *   Caps+I     up          Caps+J  left
         *   Caps+K     down        Caps+L  right
         *
         * I sits directly above K, with J and L either side, so the four form
         * the usual inverted T under the right hand.
         *
         * Everything else is transparent and falls through to the base layer,
         * so Caps+anything-else types what it normally would. The physical
         * arrow cluster is untouched and still works.
         */
        nav_layer {
            display-name = "Nav";
            bindings = <
                &trans     &trans     &trans     &trans     &trans     &trans     &trans
                &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans

                &trans     &trans     &trans     &trans     &trans     &trans     &trans
                &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans

                &trans     &trans     &trans     &trans     &trans     &trans
                &trans     &trans     &kp UP     &trans     &trans     &trans     &trans     &trans

                &trans     &trans     &trans     &trans     &trans     &trans
                &trans     &kp LEFT   &kp DOWN   &kp RIGHT  &trans     &trans     &trans     &trans

                &trans     &trans     &trans     &trans     &trans     &trans     &trans
                &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans

                &trans     &trans     &trans     &trans     &trans
                &trans     &trans     &trans     &trans     &trans     &trans     &trans
            >;
        };
    };
};
